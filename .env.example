# Environment template — copy to .env and adjust locally.
# Do not commit .env.

POSTGRES_USER=ordering
POSTGRES_PASSWORD=ordering
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CUSTOMER_DATABASE_URL=postgresql://ordering:ordering@postgres:5432/customer_db
PRODUCT_DATABASE_URL=postgresql://ordering:ordering@postgres:5432/product_db
ORDER_DATABASE_URL=postgresql://ordering:ordering@postgres:5432/order_db

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_PREFETCH=1
ORDER_MAX_RETRIES=3
CACHE_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400

LOG_LEVEL=INFO

CORE_API_PORT=8000
CUSTOMER_SERVICE_URL=http://customer-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
PROXY_TIMEOUT=10
